{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "RequireApiKey": true
  }
}
