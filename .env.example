# Copy to .env and set your own values. .env is never committed.

# PostgreSQL (docker compose "db" service)
POSTGRES_USER=loghub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loghub
POSTGRES_PORT=5432

# LogHub API started with "dotnet run" connects to the local PostgreSQL
ConnectionStrings__LogHub=Host=localhost;Port=5432;Database=loghub;Username=loghub;Password=change-me

# Host port of the LogHub container (docker compose "app" service)
LOGHUB_PORT=8080

# docker-compose.prod.yml only: public host name (Caddy gets its HTTPS certificate) and image tag (e.g. 1.2 or 1.2.3)
LOGHUB_DOMAIN=loghub.example.com
LOGHUB_VERSION=latest

# First administrator, created only when the database has no accounts (username: admin).
# When empty, LogHub generates a one-time password and writes it to the log.
Auth__AdminPassword=change-me-at-least-12-chars

# Keep events this many days (all-events retention policy, read-only in the UI). Empty: manage it in the UI.
Retention__DefaultDays=180

# Behind Azure Container Apps / App Service / a reverse proxy that sets X-Forwarded-* headers
# (docker-compose.prod.yml forces true: Caddy is in front)
Proxy__TrustForwardedHeaders=false

# Optional: Microsoft Entra ID (OpenID Connect) login
# Auth__Oidc__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
# Auth__Oidc__ClientId=
# Auth__Oidc__ClientSecret=
# Auth__Oidc__AutoProvision=false
# Auth__Oidc__AllowedTenants__0=<tenant-id>

# Encrypt the session/secret key ring outside Azure: PFX certificate mounted into the container
# DataProtection__CertificatePath=/certs/dataprotection.pfx
# DataProtection__CertificatePassword=

# Only send alert emails to these domains
# Alerts__AllowedRecipientDomains__0=example.com

# Optional: SMTP for email alerts (otherwise configure it in Settings > Email)
# Smtp__Host=
# Smtp__Port=587
# Smtp__Security=StartTls
# Smtp__Username=
# Smtp__Password=
# Smtp__FromAddress=
# Smtp__PublicUrl=https://loghub.example.com
